@@ -0,0 +1,69 @@
+/**
+ * Web preview only (marketing recordings): the partner-line loader without a file cache.
+ * expo-file-system has no cache directory in a browser, so every line failed to load and the
+ * run said "A partner line could not load". Here the line plays straight from its URL; the
+ * order, polling and retries are the iOS loader's. The iOS build never loads this file
+ * (Metro picks loader.ts there).
+ */
+
+import { type LineSource, pollAudio } from '../../api/rehearsal';
+import type { LinePlayer } from './player';
+
+const POLL_MS = 250;
+/** A line is tried this many times, then it stays failed; the run tells the actor rather than spinning. */
+const MAX_ATTEMPTS = 3;
+
+export class LineLoader {
+  private order: number[] = [];
+  private sources = new Map<number, LineSource>();
+  private started = new Set<number>();
+  private attempts = new Map<number, number>();
+  private inflight = 0;
+  private stopped = false;
+  onReady: ((lineIndex: number) => void) | null = null;
+  onFailed: ((lineIndex: number, why: string) => void) | null = null;
+
+  constructor(private player: LinePlayer, private concurrency = 2) {}
+
+  set(lineIndex: number, src: LineSource) { this.sources.set(lineIndex, src); if (!this.order.includes(lineIndex)) this.order.push(lineIndex); }
+
+  /** Make sure `lineIndex` and the lines after it are moving. Called on every engine change. */
+  ahead(lineIndex: number) { this.pump(lineIndex); }
+
+  private pump(from = 0) {
+    const room = this.concurrency - this.inflight;
+    if (room <= 0 || this.stopped) return;
+    const pending = this.order.filter(i => i >= from && !this.started.has(i) && !this.player.has(i) && (this.attempts.get(i) ?? 0) < MAX_ATTEMPTS);
+    for (const i of pending.slice(0, room)) void this.load(i);
+  }
+
+  private async load(i: number): Promise<void> {
+    const src = this.sources.get(i);
+    if (!src || this.started.has(i) || this.player.has(i)) return;
+    this.started.add(i);
+    this.attempts.set(i, (this.attempts.get(i) ?? 0) + 1);
+    this.inflight++;
+    let decoded = false;
+    try {
+      let url = src.url;
+      while (!url && !this.stopped) {
+        await new Promise(r => setTimeout(r, POLL_MS));
+        url = await pollAudio(src.key);
+      }
+      if (!url) return; // stopped while polling
+      await this.player.load(i, url);
+      decoded = true;
+    } catch (e) {
+      this.started.delete(i);
+      this.onFailed?.(i, e instanceof Error ? e.message : String(e));
+    } finally {
+      this.inflight--;
+    }
+    if (decoded) { this.onReady?.(i); this.pump(i); }
+  }
+
+  stop() {
+    this.stopped = true;
+    for (const i of this.started) if (!this.player.has(i)) this.started.delete(i);
+  }
+}
diff --git a/src/rehearsal/native/tape-ear.web.ts b/src/rehearsal/native/tape-ear.web.ts
new file mode 100644
index 0000000..6d02a56
--- /dev/null
+++ b/src/rehearsal/native/tape-ear.web.ts
@@ -0,0 +1,55 @@
+/**
+ * Web preview only (marketing recordings): the tape room's ear without a microphone.
+ *
+ * A browser has no on-device recogniser, so this ear "hears" what the recorder hands it:
+ * window.__tapeSay("and action") delivers those words one by one, as Apple's recogniser
+ * would, and everything after that is the real room: tape-cues.ts decides whether a word is
+ * a cue or a line, live-read.ts moves the piece under the lens. The iOS build never loads
+ * this file (Metro picks tape-ear.ts there).
+ */
+import { tokenize } from '../word-match';
+import type { Heard } from '../tape-cues';
+import type { TapeEarCallbacks } from './tape-ear';
+
+export type { TapeEarCallbacks };
+
+declare global {
+  interface Window { __tapeSay?: (text: string, msPerWord?: number) => Promise<void>; __tapeEarReady?: boolean }
+}
+
+export class TapeEar {
+  private words: string[] = [];
+  private at: number[] = [];
+  private base = 0;
+  private listening = false;
+  constructor(private cb: TapeEarCallbacks) {}
+
+  static available(): boolean { return true; }
+  static speakerOut() {}
+  static async permission(): Promise<boolean> { return true; }
+
+  attach() {
+    window.__tapeSay = async (text: string, msPerWord = 260) => {
+      for (const w of tokenize(text)) {
+        if (!this.listening) return;
+        this.words.push(w);
+        this.at.push(Date.now());
+        this.cb.onLevel?.(0.7);
+        this.emit();
+        await new Promise((r) => setTimeout(r, msPerWord));
+      }
+      this.cb.onLevel?.(0.1);
+    };
+    window.__tapeEarReady = true;
+  }
+  prime(_script: string[]) {}
+  listen() { this.listening = true; this.words = []; this.at = []; this.base = 0; }
+  reset() { this.base = this.words.length; this.emit(); }
+  refresh() {}
+  stop() { this.listening = false; }
+  detach() { this.stop(); window.__tapeEarReady = false; }
+  private emit() {
+    const h: Heard = { words: this.words.slice(this.base), at: this.at.slice(this.base) };
+    this.cb.onHeard(h);
+  }
+}
