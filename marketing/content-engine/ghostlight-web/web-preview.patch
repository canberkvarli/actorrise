diff --git a/README.md b/README.md
index 3748a9a..57357f0 100644
--- a/README.md
+++ b/README.md
@@ -67,3 +67,24 @@ stays legible. Not a demo of Skia. The light is emphasis; the words are the prod
 
 Step 1 (onboarding) does not start until Step 0 feels good. The build order in spec §5 is
 deliberate.
+
+## Web preview (branch `web-preview` only)
+
+A browser build of the real screens at phone size, so Playwright can record them for marketing
+videos. It is not a web version of the app and never ships: it lives on this branch, and every
+change it needs is web only (`*.web.ts` files, a `Platform.OS === 'web'` guard, and a web-only
+resolver in `metro.config.js`). iOS and Android bundles are unchanged.
+
+```bash
+scripts/web-preview.sh        # builds dist/ and serves it on http://127.0.0.1:8099
+```
+
+Record at 390x844, device scale 3, mobile, en-US. What differs from the phone:
+
+- No anonymous session is minted on web (it would add a user per recording). Signed out, the
+  tab bar stays hidden and search, saves and the board ask to sign in. Sign in with email and
+  password at `/auth`, then reuse Playwright's `storageState` so later runs start signed in.
+- No offline shelf (`src/lib/offline.web.ts`) and no purchases (the paywall says the App Store is
+  unreachable). Haptics, tilt and the microphone do nothing useful in a browser; untested.
+- `/api` goes through the local server to api.actorrise.com, because the API does not allow a
+  localhost origin.
diff --git a/app/tape/[id].tsx b/app/tape/[id].tsx
index c15f7af..e77f3a7 100644
--- a/app/tape/[id].tsx
+++ b/app/tape/[id].tsx
@@ -211,6 +211,9 @@ export default function TapeRoom() {
   const [turn, setTurn] = useState(0); // degrees the room's chrome is turned, to follow the phone
   const turnRef = useRef(0);
   turnRef.current = turn;
+  // Web preview only (marketing recordings): a browser has no orientation sensor, so the recorder
+  // says which way the phone is held (window.__tapeTurn(-90)); the room then turns itself as on the phone.
+  useEffect(() => { if (typeof document !== 'undefined') (window as unknown as { __tapeTurn?: (d: number) => void }).__tapeTurn = (d: number) => setTurn(d); }, []);
   const [count, setCount] = useState(3);
   const [elapsed, setElapsed] = useState(0);
   const [takes, setTakes] = useState<Take[]>([]);
diff --git a/metro.config.js b/metro.config.js
index c87360c..8a86862 100644
--- a/metro.config.js
+++ b/metro.config.js
@@ -1,9 +1,49 @@
+const path = require('path');
 const { getDefaultConfig } = require('expo/metro-config');
 const { withUniwindConfig } = require('uniwind/metro');
 
 const config = getDefaultConfig(__dirname);
 
-module.exports = withUniwindConfig(config, {
+const uniwindConfig = withUniwindConfig(config, {
   cssEntryFile: './src/global.css',
   dtsFile: './src/uniwind-types.d.ts',
 });
+
+// Web preview only (branch web-preview, for marketing recordings). Uniwind 1.11 lists
+// InputAccessoryView among the react-native-web components it swaps for its own, but
+// ships no file for it, so the web bundle fails to resolve. Hand that one import
+// straight to react-native-web. iOS and Android never take this path.
+const webPreviewDir = path.join(__dirname, 'web-preview');
+const uniwindResolve =uniwindConfig.resolver.resolveRequest;
+uniwindConfig.resolver.resolveRequest = (context, moduleName, platform) => {
+  if (
+    platform === 'web' &&
+    moduleName === './exports/InputAccessoryView' &&
+    context.originModulePath.includes(`${path.sep}react-native-web${path.sep}`)
+  ) {
+    return {
+      type: 'sourceFile',
+      filePath: path.join(
+        path.dirname(context.originModulePath),
+        'exports',
+        'InputAccessoryView',
+        'index.js',
+      ),
+    };
+  }
+  // Web preview only: start the web bundle from web-preview/entry.js, which loads
+  // Skia's CanvasKit before handing over to expo-router/entry.
+  if (
+    platform === 'web' &&
+    /(^|\/)expo-router\/entry(\.js)?$/.test(moduleName) &&
+    !context.originModulePath.startsWith(webPreviewDir) &&
+    !context.originModulePath.includes(`${path.sep}node_modules${path.sep}`)
+  ) {
+    return { type: 'sourceFile', filePath: path.join(webPreviewDir, 'entry.js') };
+  }
+  return uniwindResolve
+    ? uniwindResolve(context, moduleName, platform)
+    : context.resolveRequest(context, moduleName, platform);
+};
+
+module.exports = uniwindConfig;
