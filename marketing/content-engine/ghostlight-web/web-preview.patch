+// Web preview entry (branch web-preview, marketing recordings only). metro.config.js
+// points the web bundle here instead of expo-router/entry. Skia on web needs CanvasKit
+// on the global before any Skia module runs, so load it first, then start the app.
+// canvaskit.wasm is copied into dist/ by scripts/web-preview.sh. Native never loads this.
+import { LoadSkiaWeb } from '@shopify/react-native-skia/lib/module/web';
+
+LoadSkiaWeb({ locateFile: (file) => `/${file}` }).then(() => {
+  require('expo-router/entry');
+});
