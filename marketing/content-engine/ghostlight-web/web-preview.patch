diff --git a/src/lib/takes.web.ts b/src/lib/takes.web.ts
new file mode 100644
index 0000000..3f6667d
--- /dev/null
+++ b/src/lib/takes.web.ts
@@ -0,0 +1,60 @@
+/**
+ * Web preview only (marketing recordings): the tape room's shelf in memory.
+ *
+ * A browser has no documents folder, so a take recorded by the preview's camera shim
+ * (a blob: URL from MediaRecorder) is kept in a list for the session. The room, the
+ * review and the cues are the real ones; only where the file lives differs. The iOS
+ * build never loads this file (Metro picks takes.ts there).
+ */
+export const FREE_TAPE = 'free';
+export const SLATE_TAPE = 'slate';
+
+export interface Take {
+  id: string; pieceId: string; number: number; file: string; createdAt: number;
+  durationMs: number; endMs: number; startMs?: number; starred: boolean;
+  character?: string; source?: string; turn?: number; thumb?: string;
+}
+
+type WebFile = { uri: string; exists: boolean; delete(): void };
+let shelf: Take[] = [];
+let last: string | null = null;
+
+const fileOf = (uri: string): WebFile => ({
+  uri,
+  exists: Boolean(uri),
+  delete() { try { URL.revokeObjectURL(uri); } catch { /* gone */ } },
+});
+
+export async function lastTapePiece(): Promise<string | null> { return last; }
+export async function rememberTapePiece(id: string): Promise<void> { last = id; }
+
+export function takeFile(take: Pick<Take, 'file'>): WebFile { return fileOf(take.file); }
+export function thumbFile(_take: Take): WebFile | null { return null; }
+
+export async function takesFor(pieceId: string): Promise<Take[]> {
+  return shelf.filter((t) => t.pieceId === pieceId).sort((a, b) => a.number - b.number);
+}
+
+export async function addTake(
+  pieceId: string, recordedUri: string, durationMs: number, endMs: number,
+  meta: { character?: string; source?: string; turn?: number } = {},
+): Promise<Take> {
+  const number = shelf.filter((t) => t.pieceId === pieceId).reduce((m, t) => Math.max(m, t.number), 0) + 1;
+  const take: Take = { id: `${pieceId}-${Date.now().toString(36)}`, pieceId, number, file: recordedUri,
+    createdAt: Date.now(), durationMs, endMs, starred: false, ...meta };
+  shelf = [...shelf, take];
+  return take;
+}
+
+export async function allTakes(): Promise<Take[]> { return [...shelf].sort((a, b) => b.createdAt - a.createdAt); }
+export async function getTake(id: string): Promise<Take | null> { return shelf.find((t) => t.id === id) ?? null; }
+export async function setTrim(id: string, startMs: number, endMs: number): Promise<void> {
+  shelf = shelf.map((t) => (t.id === id ? { ...t, startMs, endMs } : t));
+}
+export async function setStarred(id: string, starred: boolean): Promise<void> {
+  shelf = shelf.map((t) => (t.id === id ? { ...t, starred } : t));
+}
+export async function deleteTake(id: string): Promise<void> {
+  shelf.find((t) => t.id === id && takeFile(t).delete());
+  shelf = shelf.filter((t) => t.id !== id);
+}
