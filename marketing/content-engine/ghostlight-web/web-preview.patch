+#!/usr/bin/env bash
+# Web preview of Ghost Light, for marketing screen recordings only. Not a product.
+# Builds the web export into dist/ and serves it on a port, with /api passed through
+# to api.actorrise.com so the browser stays on one origin.
+#   scripts/web-preview.sh [port]      (default 8099)
+# Needs .env with EXPO_PUBLIC_SUPABASE_URL and EXPO_PUBLIC_SUPABASE_ANON_KEY.
+set -euo pipefail
+cd "$(dirname "$0")/.."
+PORT="${1:-8099}"
+
+node scripts/web-preview-camera.mjs
+env -u EXPO_NO_DOTENV EXPO_PUBLIC_API_URL="http://127.0.0.1:${PORT}" \
+  npx expo export --platform web --clear
+# Skia on web loads CanvasKit's wasm from the site root.
+cp node_modules/canvaskit-wasm/bin/full/canvaskit.wasm dist/
+
+# NODE_USE_ENV_PROXY lets Node's fetch use HTTPS_PROXY where one is set (cloud sessions).
+NODE_USE_ENV_PROXY=1 exec node scripts/web-preview-server.mjs "$PORT" dist
