diff --git a/scripts/web-preview-camera.mjs b/scripts/web-preview-camera.mjs
new file mode 100644
index 0000000..20bb538
--- /dev/null
+++ b/scripts/web-preview-camera.mjs
@@ -0,0 +1,43 @@
+// Web preview only: expo-camera's web build cannot record. For marketing recordings, record()
+// films the camera's own stream with MediaRecorder until stopRecording(), and hands back a
+// blob: URL, so the room plays the take straight back the way the phone does.
+// Idempotent; touches node_modules only, never the app.
+import fs from 'node:fs';
+const f = 'node_modules/expo-camera/build/ExpoCamera.web.js';
+let s = fs.readFileSync(f, 'utf8');
+const REC = `return new Promise((res) => {
+                const stream = video.current?.srcObject;
+                if (!stream || typeof MediaRecorder === 'undefined') { globalThis.__previewStop = () => res({ uri: '' }); return; }
+                const mr = new MediaRecorder(stream, { mimeType: 'video/webm;codecs=vp8', videoBitsPerSecond: 8000000 });
+                const chunks = [];
+                mr.ondataavailable = (e) => { if (e.data && e.data.size) chunks.push(e.data); };
+                mr.onstop = () => res({ uri: URL.createObjectURL(new Blob(chunks, { type: 'video/webm' })) });
+                globalThis.__previewStop = () => { if (mr.state !== 'inactive') mr.stop(); };
+                mr.start(200);
+            });`;
+if (!s.includes('MediaRecorder(stream')) {
+  s = s.replace("console.warn('stopRecording is not supported on web.');",
+    "globalThis.__previewStop?.(); globalThis.__previewStop = undefined;");
+  s = s.replace("console.warn('record is not supported on web.');\n            return { uri: '' };", REC);
+  // an older run of this shim: upgrade it in place
+  s = s.replace("return new Promise((res) => { globalThis.__previewStop = () => res({ uri: '' }); });", REC);
+  if (!s.includes('MediaRecorder(stream')) throw new Error('expo-camera web build changed; update web-preview-camera.mjs');
+  fs.writeFileSync(f, s);
+}
+console.log('camera record shim on (MediaRecorder)');
+
+// expo-video's web player drops a play() made before its <video> mounts (the review calls
+// play() in the player's setup), so the take would sit on its first frame. Remember the ask
+// and play on mount, as the native player does.
+const v = 'node_modules/expo-video/build/VideoPlayer.web.js';
+let w = fs.readFileSync(v, 'utf8');
+if (!w.includes('__wantPlay')) {
+  w = w.replace('this._synchronizeWithFirstVideo(video);\n    }',
+    'this._synchronizeWithFirstVideo(video);\n        if (this.__wantPlay) { this.__wantPlay = false; video.play().catch(() => {}); }\n    }');
+  w = w.replace('play() {\n        this._mountedVideos.forEach((video) => {\n            video.play();\n        });\n    }',
+    'play() {\n        if (this._mountedVideos.size === 0) this.__wantPlay = true;\n        this._mountedVideos.forEach((video) => {\n            video.play();\n        });\n    }');
+  w = w.replace('pause() {\n', 'pause() {\n        this.__wantPlay = false;\n');
+  if ((w.match(/__wantPlay/g) || []).length < 4) throw new Error('expo-video web build changed; update web-preview-camera.mjs');
+  fs.writeFileSync(v, w);
+}
+console.log('video play-on-mount shim on');
diff --git a/scripts/web-preview-server.mjs b/scripts/web-preview-server.mjs
new file mode 100644
index 0000000..4779dc7
--- /dev/null
+++ b/scripts/web-preview-server.mjs
@@ -0,0 +1,81 @@
+// Web preview server (marketing recordings only, not a product).
+// Serves dist/ with a single page fallback, and passes /api/* through to the real API
+// so the browser sees one origin (api.actorrise.com does not allow localhost by CORS).
+// Usage: node scripts/web-preview-server.mjs [port] [dist dir]
+import { createServer } from 'node:http';
+import { readFile, stat } from 'node:fs/promises';
+import { extname, join, normalize, resolve } from 'node:path';
+
+const PORT = Number(process.argv[2] || process.env.PORT || 8099);
+const ROOT = resolve(process.argv[3] || 'dist');
+const API = process.env.WEB_PREVIEW_API || 'https://api.actorrise.com';
+
+const TYPES = {
+  '.html': 'text/html; charset=utf-8',
+  '.js': 'application/javascript',
+  '.css': 'text/css',
+  '.json': 'application/json',
+  '.wasm': 'application/wasm',
+  '.png': 'image/png',
+  '.jpg': 'image/jpeg',
+  '.svg': 'image/svg+xml',
+  '.ico': 'image/x-icon',
+  '.ttf': 'font/ttf',
+  '.otf': 'font/otf',
+  '.woff': 'font/woff',
+  '.woff2': 'font/woff2',
+  '.mp3': 'audio/mpeg',
+  '.mp4': 'video/mp4',
+};
+
+async function proxy(req, res) {
+  const chunks = [];
+  for await (const c of req) chunks.push(c);
+  const headers = { ...req.headers };
+  delete headers.host;
+  delete headers.origin;
+  delete headers.referer;
+  delete headers['content-length'];
+  try {
+    const upstream = await fetch(API + req.url, {
+      method: req.method,
+      headers,
+      body: ['GET', 'HEAD'].includes(req.method) ? undefined : Buffer.concat(chunks),
+      redirect: 'manual',
+    });
+    const out = {};
+    upstream.headers.forEach((v, k) => {
+      if (!['content-encoding', 'content-length', 'transfer-encoding', 'connection'].includes(k)) out[k] = v;
+    });
+    res.writeHead(upstream.status, out);
+    res.end(Buffer.from(await upstream.arrayBuffer()));
+  } catch (e) {
+    res.writeHead(502, { 'content-type': 'text/plain' });
+    res.end(`proxy error: ${e.message}`);
+  }
+}
+
+async function serveFile(req, res) {
+  const path = decodeURIComponent(new URL(req.url, 'http://x').pathname);
+  let file = normalize(join(ROOT, path));
+  if (!file.startsWith(ROOT)) file = join(ROOT, 'index.html');
+  try {
+    if ((await stat(file)).isDirectory()) file = join(file, 'index.html');
+  } catch {
+    file = join(ROOT, 'index.html');
+  }
+  try {
+    const body = await readFile(file);
+    res.writeHead(200, { 'content-type': TYPES[extname(file)] || 'application/octet-stream' });
+    res.end(body);
+  } catch {
+    res.writeHead(404);
+    res.end();
+  }
+}
+
+createServer((req, res) => (req.url.startsWith('/api/') ? proxy(req, res) : serveFile(req, res))).listen(
+  PORT,
+  '127.0.0.1',
+  () => console.log(`web preview on http://127.0.0.1:${PORT} (api -> ${API})`),
+);
